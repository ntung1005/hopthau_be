# Lấy các giá trị bằng: npm run db:env
SUPABASE_URL=http://127.0.0.1:55321
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
SUPABASE_SECRET_KEY=sb_secret_...

PORT=8788
# Origin được gọi API từ trình duyệt (Flutter web, landing). * khi phát triển.
CORS_ORIGIN=*
# Số lần đăng nhập / đăng ký / gửi form mỗi 5 phút cho một IP.
AUTH_MAX_ATTEMPTS=10
