{
  "name": "hopthau-be",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "node --env-file=.env --watch src/server.ts",
    "start": "node --env-file=.env src/server.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --test test/*.test.ts",
    "e2e": "node --env-file=.env test/e2e.ts",
    "db:start": "supabase start",
    "db:reset": "supabase db reset",
    "db:env": "supabase status -o env",
    "make-admin": "node --env-file=.env scripts/make_admin.ts",
    "demo": "node --env-file=.env scripts/demo_data.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.57.0",
    "cors": "^2.8.6",
    "express": "^5.2.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^22.18.0",
    "supabase": "2.117.0",
    "typescript": "^5.9.0"
  }
}